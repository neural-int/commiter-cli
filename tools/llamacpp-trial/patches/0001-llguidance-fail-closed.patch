+static const uint32_t * llama_sampler_llg_mask(llama_sampler_llg * ctx) {
+    if (llg_matcher_get_error(ctx->grammar)) {
+        llama_sampler_llg_fail("state");
+    }
+    const uint32_t * mask = llg_matcher_get_mask(ctx->grammar);
+    if (mask == nullptr) {
+        if (llg_matcher_compute_mask(ctx->grammar) != 0) {
+            llama_sampler_llg_fail("mask");
+        }
+        mask = llg_matcher_get_mask(ctx->grammar);
+    }
+    if (mask == nullptr || llg_matcher_get_error(ctx->grammar)) {
+        llama_sampler_llg_fail("mask");
+    }
+    return mask;
+}
