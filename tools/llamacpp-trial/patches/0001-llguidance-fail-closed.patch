+// commiter owns one non-streaming server per planning cycle. The sampler API
+// cannot propagate failures to every caller, so stop the process before any
+// unconstrained token or successful completion can escape. Do not run teardown
+// handlers, a crash debugger or a core dump on this failure path.
+[[noreturn]] static void llama_sampler_llg_fail(const char * operation) {
+    std::fprintf(stderr, "commiter: LLGuidance %s failed; stopping server\n", operation);
+    std::fflush(stderr);
+    std::_Exit(EXIT_FAILURE);
+}

