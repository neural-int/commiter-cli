      "steps": [
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"fixture-sensitive-value\",\"file_ids\":[\"F001\",\"F002\"]}]}"},
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"remove sensitive output\",\"file_ids\":[\"F001\",\"F002\"]}]}"}
