{
  "schema_version": 1,
  "file_ids": ["F001", "F002"],
  "cases": [
    {
      "name": "initial-timeout-then-success",
      "steps": [
        {"error": "timeout"},
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"recover plan\",\"file_ids\":[\"F001\",\"F002\"]}]}"}
      ],
      "want": {"success": true, "calls": 2, "repaired": false, "exit_code": 0}
    },
    {
      "name": "initial-transport-then-success",
      "steps": [
        {"error": "transport"},
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"recover plan\",\"file_ids\":[\"F001\",\"F002\"]}]}"}
      ],
      "want": {"success": true, "calls": 2, "repaired": false, "exit_code": 0}
    },
    {
      "name": "repair-timeout-then-success",
      "steps": [
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"needs repair\",\"file_ids\":[\"F001\"]}]}"},
        {"error": "timeout"},
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"repair plan\",\"file_ids\":[\"F001\",\"F002\"]}]}"}
      ],
      "want": {"success": true, "calls": 3, "repaired": true, "repair": true, "exit_code": 0, "repair_violations": ["invalid_assignment"]}
    },
    {
      "name": "repair-transport-then-success",
      "steps": [
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"needs repair\",\"file_ids\":[\"F001\"]}]}"},
        {"error": "transport"},
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"repair plan\",\"file_ids\":[\"F001\",\"F002\"]}]}"}
      ],
      "want": {"success": true, "calls": 3, "repaired": true, "repair": true, "exit_code": 0, "repair_violations": ["invalid_assignment"]}
    },
    {
      "name": "initial-retry-budget-exhausted",
      "steps": [
        {"error": "timeout"},
        {"error": "transport"}
      ],
      "want": {"success": false, "calls": 2, "repaired": false, "exit_code": 5}
    },
    {
      "name": "repair-retry-budget-exhausted",
      "steps": [
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"needs repair\",\"file_ids\":[\"F001\"]}]}"},
        {"error": "timeout"},
        {"error": "transport"}
      ],
      "want": {"success": false, "calls": 3, "repaired": false, "repair": true, "exit_code": 5, "repair_violations": ["invalid_assignment"]}
    },
    {
      "name": "invalid-json-repaired",
      "steps": [
        {"content": "not-json"},
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"repair invalid JSON\",\"file_ids\":[\"F001\",\"F002\"]}]}"}
