        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"repair schema\",\"file_ids\":[\"F001\",\"F002\"]}],\"body\":\"unexpected\"}"},
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"repair schema\",\"file_ids\":[\"F001\",\"F002\"]}]}"}
