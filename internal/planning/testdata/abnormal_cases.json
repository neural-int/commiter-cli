      "steps": [
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"unknown\",\"scope\":\"\",\"breaking\":false,\"summary\":\"fixture-sensitive-value\\nextra\",\"file_ids\":[\"F001\",\"F999\"]}]}"},
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"repair multiple violations\",\"file_ids\":[\"F001\",\"F002\"]}]}"}
