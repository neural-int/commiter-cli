    {
      "name": "repair-remains-invalid",
      "steps": [
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"needs repair\",\"file_ids\":[\"F001\"]}]}"},
        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"still invalid\",\"file_ids\":[\"F001\"]}]}"}
