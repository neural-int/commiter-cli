        {"content": "{\"schema_version\":1,\"commits\":[{\"type\":\"fix\",\"scope\":\"planner\",\"breaking\":false,\"summary\":\"repair duplicate file\",\"file_ids\":[\"F001\",\"F002\"]}]}"}
      ],
      "want": {"success": true, "calls": 2, "repaired": true, "repair": true, "exit_code": 0, "repair_violations": ["invalid_assignment"]}
