  "context_contract": {
    "supported_language": "Go only for this bounded study; other language omits context with reason",
    "ast": "Tree-sitter both before/after from immutable Git bytes; functions and methods only",
    "receiver_qualification": "receiver type identifier without pointer prefix + . + method name; functions plain name",
    "replacement": "changed run bounded by context lines; exact before/after set of unambiguous declaration names must agree; otherwise omit entire run",
    "line_ambiguity": "entire trimmed changed code line must fit one function/method; top-level/blank/multiple on one line/parse error omitted with reason",
    "dedup": "hunk_index + name, sort by hunk then UTF-8 name",
    "max_entries_per_file": 32,
    "max_name_utf8_bytes": 128,
    "cap": "omit overlong names; retain first 32 sorted entries, log count; never truncate raw diff",
    "raw_diff": "git diff HEAD --no-ext-diff --no-textconv --unified=3, full headers/old/new/context kept",
    "max_raw_bytes_per_file": 65536,
    "max_total_raw_bytes": 131072
  },
  "gate1": {
    "quality": "holdout coverage >=90%, exact >=80%, grounded >=95%, overmerge/oversplit/hallucination=0, schema and all planned small-input admission=100%",
    "relative_to_A": "B or C improves coverage OR exact by >=25 percentage points, neither metric worse; hallucination/over-split no worse",
    "resources": "all generation calls observed; wall p95<=120s, max RSS<=6GiB, swap before/after delta<=256MiB, pressure<4, Git unchanged; native token count must match preflight",
    "scale_probe": "S16 input-admission only, not small-input quality denominator; fails forbid 16-file adoption claim"
  },
  "C_increment": "At least one more covered gold purpose AND one more exact cell than B, overmerge/split/hallucination not worse, grounding not worse; input tokens and wall p95 at most 1.25x B; C must pass absolute gate to be candidate",
  "B_C_decision": "B absolute pass + no confirmed beneficial C increment -> prefer B; C absolute pass + increment -> C candidate; both absolute fail -> both NO-GO; C alone absolute pass without increment -> defer; insufficient observations -> defer",
  "gate2": {
    "absolute": "holdout exact partition>=80%, False Merge=0, False Split=0, schema/complete assignment=100%, fallback/unresolved=0; same resource limits",
    "relative": "B or C has fewer FM than A, FS/fallback not worse, exact not worse; C candidate additionally fewer FM OR >=1 more exact than B with FS/fallback not worse and cost<=1.25x",
    "mixed_file": "no file splitting; files needed for either purpose of indivisible mixed file are one group; purpose count and file partition exact are separate"
