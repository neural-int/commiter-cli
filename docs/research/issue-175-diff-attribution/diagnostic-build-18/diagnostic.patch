+use std::io::Write;
+static LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());
+pub(crate) struct Span { name: &'static str, start: std::time::Instant }
+pub(crate) fn span(name: &'static str) -> Span { Span { name, start: std::time::Instant::now() } }
+impl Drop for Span { fn drop(&mut self) {
+ if let Some(dir)=std::env::var_os("COMMITER_DIAGNOSTIC_DIR") {
+  let duration=self.start.elapsed().as_nanos();
+  let end=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_nanos();
+  let Ok(_lock)=LOCK.lock() else {return};
+  let path=std::path::PathBuf::from(dir).join(format!("{}.app-server.jsonl",std::process::id()));
+  if let Ok(mut file)=std::fs::OpenOptions::new().create(true).append(true).open(path) {
+   let line=format!("{{\"stage\":\"{}\",\"end_ns\":{},\"duration_ns\":{}}}\n",self.name,end,duration);
+   let _=file.write_all(line.as_bytes());
+  }
+ }
+}}
